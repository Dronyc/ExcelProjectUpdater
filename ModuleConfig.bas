'---------------------------------------------------------------
' ТЕКСТЫ ФОРМУЛ ВАЛИДАЦИИ И АНАЛИТИКИ (Calculated Columns тблПроекты)
' Логика проверок — ТОЛЬКО здесь; VBA лишь внедряет строку формулы.
'---------------------------------------------------------------
Public Const FRM_CHECK_CONTRACTOR As String = _
    "=IF(ISBLANK([@[Дата создания]]),FALSE,OR(LEN(TRIM([@[Контрагент]]))=0,LEN(TRIM([@[Контрагент]]))=1,AND(LEN(TRIM([@[Контрагент]]))>1,EXACT(TRIM([@[Контрагент]]),REPT(LEFT(TRIM([@[Контрагент]]),1),LEN(TRIM([@[Контрагент]])))))))"

Public Const FRM_CHECK_DATE As String = _
    "=IF(ISBLANK([@[Дата создания]]),FALSE,OR(ISBLANK([@[Дата создания]]),NOT(ISNUMBER([@[Дата создания]]))))"

Public Const FRM_CHECK_CODE As String = _
    "=IF(AND(ISBLANK([@[Дата создания]]),TRIM([@[Код в базе 1С:УПП]])=""""),FALSE,OR(LEN(TRIM([@[Код в базе 1С:УПП]]))=0,LEFT(TRIM([@[Код в базе 1С:УПП]]),2)<>"Я-"))"

Public Const FRM_CHECK_PROJCODE As String = _
    "=IF(ISBLANK([@[Дата создания]]),FALSE,OR(LEN(TRIM([@[Код проекта в 1С:УПП]]))=0,LEN(TRIM([@[Код проекта в 1С:УПП]]))=1,AND(LEN(TRIM([@[Код проекта в 1С:УПП]]))>1,EXACT(TRIM([@[Код проекта в 1С:УПП]]),REPT(LEFT(TRIM([@[Код проекта в 1С:УПП]]),1),LEN(TRIM([@[Код проекта в 1С:УПП]])))))))"

Public Const FRM_CHECK_NAME As String = _
    "=IF(ISBLANK([@[Дата создания]]),FALSE,OR(LEN(TRIM([@[Наименование проекта]]))=0,LEN(TRIM([@[Наименование проекта]]))=1,AND(LEN(TRIM([@[Наименование проекта]]))>1,EXACT(TRIM([@[Наименование проекта]]),REPT(LEFT(TRIM([@[Наименование проекта]]),1),LEN(TRIM([@[Наименование проекта]])))))))"

Public Const FRM_CHECK_STATE As String = _
    "=IF(ISBLANK([@[Дата создания]]),FALSE,OR(LEN(TRIM([@[Состояние]]))=0,LEN(TRIM([@[Состояние]]))=1,AND(LEN(TRIM([@[Состояние]]))>1,EXACT(TRIM([@[Состояние]]),REPT(LEFT(TRIM([@[Состояние]]),1),LEN(TRIM([@[Состояние]])))))))"

Public Const FRM_BAD_STATE As String = _
    "=IF(ISBLANK([@[Дата создания]]),FALSE,IF(LEN(TRIM([@[Состояние]]))=0,FALSE,ISNA(MATCH(TRIM([@[Состояние]]),ДопустимыеСостояния,0))))"

Public Const FRM_CHECK_CURATOR As String = _
    "=IF(ISBLANK([@[Дата создания]]),FALSE,OR(LEN(TRIM([@[Куратор]]))=0,LEN(TRIM([@[Куратор]]))=1,AND(LEN(TRIM([@[Куратор]]))>1,EXACT(TRIM([@[Куратор]]),REPT(LEFT(TRIM([@[Куратор]]),1),LEN(TRIM([@[Куратор]])))))))"

Public Const FRM_CHECK_MANAGER As String = _
    "=IF(ISBLANK([@[Дата создания]]),FALSE,OR(LEN(TRIM([@[Менеджер ОП]]))=0,LEN(TRIM([@[Менеджер ОП]]))=1,AND(LEN(TRIM([@[Менеджер ОП]]))>1,EXACT(TRIM([@[Менеджер ОП]]),REPT(LEFT(TRIM([@[Менеджер ОП]]),1),LEN(TRIM([@[Менеджер ОП]])))))))"

Public Const FRM_BAD_FIELDS_LIST As String = _
    "=IF(ISBLANK([@[Дата создания]]),"""",TEXTJOIN("", "",TRUE,IF([@[Проверка Контрагент]],""Контрагент"""""","""")),IF([@[Проверка Дата создания]],""Дата создания"""""","""")),IF([@[Проверка Код]],""Код в базе 1С:УПП"""""","""")),IF([@[Проверка Код проекта в 1С:УПП]],""Код проекта в 1С:УПП"""""","""")),IF([@[Проверка Наименование проекта]],""Наименование проекта"""""","""")),IF(OR([@[Проверка Состояние]],[@[Недопустимое Состояние]]),""Состояние"""""","""")),IF([@[Проверка Куратор]],""Куратор"""""","""")),IF([@[Проверка Менеджер ОП]],""Менеджер ОП"""""",""""))))"

Public Const FRM_REQUIRED_ERROR As String = _
    "=IF([@[Список некорректных полей]]="""",FALSE,TRUE)"

Public Const FRM_ERROR_COUNT As String = _
    "=([@[Проверка Контрагент]]+[@[Проверка Дата создания]]+[@[Проверка Код]]+[@[Проверка Код проекта в 1С:УПП]]+[@[Проверка Наименование проекта]]+[@[Проверка Состояние]]+[@[Недопустимое Состояние]]+[@[Проверка Куратор]]+[@[Проверка Менеджер ОП]])"

Public Const FRM_PROJECT_CLOSED As String = _
    "=IF([@[Дата создания]]="""","""",OR([@[Состояние]]=""Завершен"",[@[Состояние]]=""Прекращен с отрицательным результатом"",[@[Состояние]]=""Не состоялся""))"

Public Const FRM_GROUP_PGS As String = _
    "=IF(ISBLANK([@[Продукт]]),"""",IF(ISNUMBER(SEARCH(""ПГС"",IFERROR(VLOOKUP(TRIM([@[Продукт]]),тблСправочникПродуктов,2,FALSE),""""))),""да"",IF(ISNUMBER(SEARCH(""ТИМ"",IFERROR(VLOOKUP(TRIM([@[Продукт]]),тблСправочникПродуктов,2,FALSE),""""))),""да"","""")))"

Public Const FRM_GROUP_PLM As String = _
    "=IF(ISBLANK([@[Продукт]]),"""",IF(ISNUMBER(SEARCH(""PLM"",IFERROR(VLOOKUP(TRIM([@[Продукт]]),тблСправочникПродуктов,2,FALSE),""""))),""да"",""""))"

Public Const FRM_DUP_CODE As String = _
    "=IF(OR(ISBLANK([@[Дата создания]]),LEN(TRIM([@[Код в базе 1С:УПП]]))=0),FALSE,COUNTIFS([Код в базе 1С:УПП],[@[Код в базе 1С:УПП]],[Статус проверки ручной],""<>Архивировать"")>1)"

Public Const FRM_DUP_LINK As String = _
    "=IF(OR(ISBLANK([@[Дата создания]]),LEN(TRIM([@[Ссылка на проект]]))=0),FALSE,COUNTIFS([Ссылка на проект],[@[Ссылка на проект]],[Статус проверки ручной],""<>Архивировать"")>1)"

Public Const FRM_AUTOSTATUS As String = _
    "=IF(ISBLANK([@[Дата создания]]),"""",IF(OR([@[Ошибка обязательных полей]],[@[Дубль кода]],[@[Дубль ссылки]]),IF(LEN(TRIM([@[Ответственный за статус]]))=0,""Не назначен Ответственный за статус"",""Не соответствует требованиям""),IF(LEN(TRIM([@[Ссылка на проект]]))=0,""Требуется ссылка"",IF(OR(TRIM([@[Состояние]])=""Завершен"",TRIM([@[Состояние]])=""Прекращен с отрицательным результатом"",TRIM([@[Состояние]])=""Не состоялся""),""Готов к передаче в архив"",""Соответствует требованиям"")))))"

Public Const FRM_AUTOCOMMENT As String = _
    "=IF(ISBLANK([@[Дата создания]]),"""",TRIM(IF([@[Ошибка обязательных полей]],""Некорректные данные в поле: ""&[@[Список некорректных полей]],"""")&IF([@[Дубль кода]],IF([@[Ошибка обязательных полей]],""; "","""")&""Дублируется Код в базе 1С:УПП"","""")&IF([@[Дубль ссылки]],IF(OR([@[Ошибка обязательных полей]],[@[Дубль кода]]),""; "","""")&""Дублируется Ссылка на проект"","""")))"

Public Const FRM_FINAL_STATUS As String = _
    "=IF(ISBLANK([@[Дата создания]]),"""",IF(OR([@[Статус проверки ручной]]=""Архивировать"",[@[Статус проверки ручной]]=""Уточнить!"",[@[Статус проверки ручной]]=""В работе""),[@[Статус проверки ручной]],[@[Статус проверки авто]]))"

Public Const FRM_FINAL_COMMENT As String = _
    "=TRIM([@[Комментарий к статусу авто]]&IF(AND([@[Комментарий к статусу авто]]<>"""",TRIM([@[Комментарий к статусу ручной]])<>""""),""; "","""")&TRIM([@[Комментарий к статусу ручной]]))"

Public Const FRM_IN_REFERENCE As String = _
    "=ЕСЛИ(ЕОШИБКА(ПОИСКПОЗ([@[Дата создания]];тблЭталон[Дата создания];0));""Нет"";""Да"")"

' Пары "столбец;формула" для массового внедрения Calculated Columns
Public Function PROJECT_FORMULAS() As Variant
    PROJECT_FORMULAS = Array( _
        "Проверка Контрагент|" & FRM_CHECK_CONTRACTOR, _
        "Проверка Дата создания|" & FRM_CHECK_DATE, _
        "Проверка Код|" & FRM_CHECK_CODE, _
        "Проверка Код проекта в 1С:УПП|" & FRM_CHECK_PROJCODE, _
        "Проверка Наименование проекта|" & FRM_CHECK_NAME, _
        "Проверка Состояние|" & FRM_CHECK_STATE, _
        "Недопустимое Состояние|" & FRM_BAD_STATE, _
        "Проверка Куратор|" & FRM_CHECK_CURATOR, _
        "Проверка Менеджер ОП|" & FRM_CHECK_MANAGER, _
        "Список некорректных полей|" & FRM_BAD_FIELDS_LIST, _
        "Ошибка обязательных полей|" & FRM_REQUIRED_ERROR, _
        "Число ошибок|" & FRM_ERROR_COUNT, _
